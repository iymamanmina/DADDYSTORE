# Netlify Functions + Supabase Postgres
# Use Supabase Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project Settings > API
SUPABASE_URL=https://ommwtekpolznlccowevn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=daddys-store-media

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
ADMIN_USERNAME=owner
# Create through npm run admin:create (script asks for password securely).

PUBLIC_BASE_URL=https://YOUR-SITE.netlify.app
# Needed for customer verification / password reset emails. Resend is optional but recommended.
RESEND_API_KEY=
EMAIL_FROM=DADDYS STORE <your-verified-sender@example.com>
# Optional alternative to Resend: configure SMTP (e.g. Gmail app password or provider SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DADDYS STORE <your-sender@example.com>
AUTH_EMAIL_DEV_MODE=0